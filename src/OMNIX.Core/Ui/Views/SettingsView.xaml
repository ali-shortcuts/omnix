<UserControl x:Class="OMNIX.Core.Ui.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="360" d:DesignHeight="700"
             Background="{DynamicResource B.Background}">

    <UserControl.Resources>
        <Style x:Key="SetButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource B.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource B.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetAccent" TargetType="Button" BasedOn="{StaticResource SetButton}">
            <Setter Property="Background" Value="{DynamicResource B.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource B.AccentForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource B.ForegroundDim}" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource B.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource B.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
            <Setter Property="CaretBrush" Value="{DynamicResource B.Foreground}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style x:Key="Secret" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource B.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource B.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource B.Foreground}" />
            <Setter Property="Background" Value="{DynamicResource B.Surface}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource B.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource B.AccentForeground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource B.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource B.AccentForeground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource B.ForegroundDim}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource B.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource B.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" />
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource B.Foreground}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="SelectedContent" Margin="6,4,28,4" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="6,4,28,4" VerticalContentAlignment="Center"
                                     Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" CaretBrush="{TemplateBinding Foreground}"
                                     BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border x:Name="DropDownBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True" MaxHeight="250" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="SelectedContent" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Radio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource B.Foreground}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
            <Setter Property="Margin" Value="0,14,0,2" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,6">
        <StackPanel>

            <!-- ============ Provider ============ -->
            <TextBlock Text="{DynamicResource S.Settings.Provider}" Style="{StaticResource Section}" />
            <ComboBox x:Name="ProviderCombo" Style="{StaticResource Combo}"
                      DisplayMemberPath="DisplayName" Margin="0,4,0,0"
                      SelectionChanged="OnProviderChanged" DropDownOpened="OnProvidersOpened" />

            <!-- ============ Custom provider ============ -->
            <StackPanel x:Name="CustomProviderSection" Visibility="Collapsed">
            <TextBlock Text="Custom Provider" Style="{StaticResource Section}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource S.Settings.CustomName}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="CustomNameBox" Style="{StaticResource Input}" />
            <TextBlock Text="Endpoint" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="CustomApiTypeCombo" Style="{StaticResource Combo}" SelectedIndex="0">
                <ComboBoxItem Content="OpenAI-compatible" />
                <ComboBoxItem Content="Anthropic-compatible" />
            </ComboBox>
            <TextBlock Text="{DynamicResource S.Settings.CustomBaseUrl}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="CustomBaseUrlBox" Style="{StaticResource Input}" />

            </StackPanel>

            <TextBlock x:Name="ApiKeyLabel" Text="{DynamicResource S.Settings.ApiKey}" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource Secret}" />
            <TextBlock x:Name="KeyStateText" Text="{DynamicResource S.Settings.ApiKeyStored}"
                       FontSize="10" Foreground="{DynamicResource B.Success}" Margin="0,2,0,0" />

            <TextBlock Text="{DynamicResource S.Settings.Model}" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ModelCombo" Style="{StaticResource Combo}" IsEditable="True" SelectionChanged="OnModelChanged" />
                <Button x:Name="LoadModelsButton" Grid.Column="1" Style="{StaticResource SetButton}"
                        Content="Detect models" Margin="4,0,0,0" Click="OnLoadModels" />
            </Grid>

            <TextBox x:Name="ManualModelBox" Style="{StaticResource Input}" Visibility="Collapsed" ToolTip="Exact model ID" Margin="0,4,0,0" />

            <StackPanel x:Name="ProviderLinksPanel" Orientation="Horizontal" Margin="0,7,0,0">
                <Button x:Name="GetApiKeyButton" Style="{StaticResource SetButton}"
                        Content="{DynamicResource S.Settings.GetApiKey}" Click="OnGetApiKey" Visibility="Collapsed" />
                <Button x:Name="ProviderDocsButton" Style="{StaticResource SetButton}" Margin="5,0,0,0"
                        Content="{DynamicResource S.Settings.ProviderDocs}" Click="OnProviderDocs" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="ProviderLinkNote" Text="{DynamicResource S.Settings.OfficialLinkOnly}"
                       FontSize="9.5" Foreground="{DynamicResource B.ForegroundDim}" Margin="0,3,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="TestButton" Style="{StaticResource SetAccent}"
                        ToolTip="Tests provider endpoint/authentication/model catalog only. It does not test the selected model."
                        Content="Test connection" Click="OnTestConnection" />
                <Button x:Name="TestModelButton" Style="{StaticResource SetButton}" Margin="6,0,0,0"
                        ToolTip="Runs a tiny document-free OMNIX tool-calling probe against only the selected model. Provider usage limits and charges may apply."
                        Content="Test model" Click="OnTestModel" />
                <Button x:Name="VerifyModelsButton" Style="{StaticResource SetButton}" Margin="6,0,0,0"
                        ToolTip="Verifies detected models one at a time for actual OMNIX tool calling with a bounded document-free probe. Stop at any time. Provider usage limits and charges may apply."
                        Content="Verify models" Click="OnVerifyModels" />
                <Button x:Name="CancelTestButton" Content="Stop" Click="OnCancelTest" Style="{StaticResource SetButton}" Visibility="Collapsed" Margin="6,4,0,0" />
            </WrapPanel>
            <CheckBox x:Name="WorkingModelsOnlyCheck" Visibility="Collapsed" Margin="0,6,0,0"
                      Foreground="{DynamicResource B.Foreground}" Content="Show OMNIX tool-compatible models only"
                      Checked="OnWorkingModelsFilterChanged" Unchecked="OnWorkingModelsFilterChanged" />
            <TextBlock x:Name="TestResultText" FontSize="11" Margin="0,6,0,0"
                       Foreground="{DynamicResource B.ForegroundDim}" TextWrapping="Wrap" />
            <ScrollViewer x:Name="ModelVerificationScroll" Visibility="Collapsed" MaxHeight="120"
                          VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                <TextBlock x:Name="ModelVerificationText" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource B.ForegroundDim}" />
            </ScrollViewer>

            <!-- ============ Local AI ============ -->
            <StackPanel x:Name="LocalProviderSection" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource S.Settings.LocalStatus}" Style="{StaticResource Section}" />
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LocalStatusText" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource B.ForegroundDim}" />
                <Button x:Name="ProbeButton" Grid.Column="1" Style="{StaticResource SetButton}"
                        Content="{DynamicResource S.Settings.ProbeNow}" Click="OnProbeLocal" />
            </Grid>
            <CheckBox x:Name="PreferLocalCheck" Foreground="{DynamicResource B.Foreground}"
                      FontSize="11.5" Margin="0,6,0,0"
                      Content="{DynamicResource S.Settings.PreferLocal}" />

            </StackPanel>
            <Expander x:Name="GeneralSettingsExpander" Header="General settings" Foreground="{DynamicResource B.Foreground}" Margin="0,12,0,0"><StackPanel>
            <!-- ============ Privacy ============ -->
            <TextBlock Text="Privacy" Style="{StaticResource Section}" />
            <RadioButton x:Name="PrivacyLocalOnly" Style="{StaticResource Radio}"
                         GroupName="OmnixPrivacy" Content="Local only" />
            <RadioButton x:Name="PrivacyCloudAllowed" Style="{StaticResource Radio}"
                         GroupName="OmnixPrivacy" Content="{DynamicResource S.Settings.Privacy.CloudAllowed}" />
            <RadioButton x:Name="PrivacyAsk" Style="{StaticResource Radio}"
                         GroupName="OmnixPrivacy" Content="Ask before sending" />

            <!-- ============ Appearance ============ -->
            <TextBlock Text="{DynamicResource S.Settings.Appearance}" Style="{StaticResource Section}" />
            <ComboBox x:Name="ThemeCombo" Style="{StaticResource Combo}" SelectionChanged="OnThemeChanged">
                <ComboBoxItem Content="{DynamicResource S.Settings.Theme.System}" Tag="System" />
                <ComboBoxItem Content="{DynamicResource S.Settings.Theme.Light}" Tag="Light" />
                <ComboBoxItem Content="{DynamicResource S.Settings.Theme.Dark}" Tag="Dark" />
            </ComboBox>
            <TextBlock Text="{DynamicResource S.Settings.Language}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="LanguageCombo" Style="{StaticResource Combo}" SelectedIndex="0">
                <ComboBoxItem Content="English" Tag="en" />
                <ComboBoxItem Content="فارسی (coming soon)" Tag="fa" IsEnabled="False" />
            </ComboBox>

            <!-- ============ Limits ============ -->
            <TextBlock Text="{DynamicResource S.Settings.HistoryLimits}" Style="{StaticResource Section}" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource S.Settings.History.Messages}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="MaxMessagesBox" Grid.Column="1" Style="{StaticResource Input}" Margin="0,4,0,0" />
                <TextBlock Text="{DynamicResource S.Settings.History.Days}" Grid.Row="1" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="MaxDaysBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Input}" Margin="0,4,0,0" />
            </Grid>

            </StackPanel></Expander>
            <Button x:Name="SaveButton" Style="{StaticResource SetAccent}" Content="Save"
                    Click="OnSave" Margin="0,16,0,12" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
