<UserControl x:Class="OMNIX.Core.Ui.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OMNIX.Core.Ui"
             mc:Ignorable="d"
             d:DesignWidth="360" d:DesignHeight="640"
             AutomationProperties.AutomationId="OMNIX.WorkspaceRoot"
             AutomationProperties.Name="OMNIX Workspace"
             Background="{DynamicResource B.Background}"
             KeyboardNavigation.TabNavigation="Cycle">

    <UserControl.Resources>
        <!-- Flat, narrow-width friendly button style (360px optimized, spec Section 5) -->
        <Style x:Key="OmnixButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource B.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource B.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource OmnixButton}">
            <Setter Property="Background" Value="{DynamicResource B.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource B.AccentForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}" />
        </Style>

        <Style x:Key="TabToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource B.ForegroundDim}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource B.AccentForeground}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource B.Foreground}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: brand + tabs -->
        <Border Grid.Row="0" Background="{DynamicResource B.Background}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="OMNIX" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <RadioButton x:Name="TabChat" Style="{StaticResource TabToggle}"
                                 GroupName="OmnixTabs"
                                 Content="{DynamicResource S.Tab.Chat}" Checked="ShowChat" />
                    <RadioButton x:Name="TabSettings" Style="{StaticResource TabToggle}"
                                 GroupName="OmnixTabs" Content="{DynamicResource S.Tab.Settings}" Checked="ShowSettings" />
                    <RadioButton x:Name="TabAbout" Style="{StaticResource TabToggle}"
                                 GroupName="OmnixTabs" Content="{DynamicResource S.Tab.About}" Checked="ShowAbout" />
                    <RadioButton x:Name="TabLearn" Style="{StaticResource TabToggle}" GroupName="OmnixTabs" Content="Learn" Checked="ShowLearn" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Pages -->
        <Grid Grid.Row="1">
            <local:ChatView x:Name="ChatPage" />
            <local:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
            <DockPanel x:Name="LearnPage" Visibility="Collapsed" Margin="8">
                <StackPanel DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ReferenceHost" Grid.Column="0" SelectedIndex="0" SelectionChanged="ReferenceChanged">
                            <ComboBoxItem Content="Excel" /><ComboBoxItem Content="Word" /><ComboBoxItem Content="PowerPoint" />
                        </ComboBox>
                        <ComboBox x:Name="ReferenceLanguage" Grid.Column="1" SelectedIndex="0"
                                  SelectionChanged="ReferenceChanged" Margin="6,0,0,0" MinWidth="82">
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="فارسی" Tag="fa" />
                        </ComboBox>
                    </Grid>
                    <TextBox x:Name="ReferenceQuery" TextChanged="ReferenceChanged" ToolTip="Search function name" Margin="0,6" />
                    <WrapPanel>
                        <Button x:Name="ReferencePreviousButton" Content="Previous" Click="ReferencePrevious" />
                        <Button x:Name="ReferenceNextButton" Content="Next" Click="ReferenceNext" Margin="6,0" />
                    </WrapPanel>
                </StackPanel>
                <TextBox x:Name="ReferenceText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource B.Background}" Foreground="{DynamicResource B.Foreground}" BorderThickness="0" />
            </DockPanel>
            <local:AboutView x:Name="AboutPage" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
